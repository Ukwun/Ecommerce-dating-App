# Backend & WebSocket
EXPO_PUBLIC_SERVER_URI=https://ecommerce-dating-app.onrender.com
EXPO_PUBLIC_BACKEND_URL=https://ecommerce-dating-app.onrender.com
EXPO_PUBLIC_CHATTING_WEBSOCKET_URI=wss://ecommerce-dating-app.onrender.com

# Image Upload (ImageKit) - NO PRIVATE KEY HERE!
# All image uploads must go through backend endpoint
EXPO_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
EXPO_PUBLIC_CLOUDINARY_UPLOAD_PRESET=your_unsigned_preset

# Google OAuth (Get credentials from Google Cloud Console)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=YOUR_GOOGLE_IOS_CLIENT_ID
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=YOUR_GOOGLE_ANDROID_CLIENT_ID

# Facebook OAuth (Get App ID from Facebook Developers)
EXPO_PUBLIC_FACEBOOK_APP_ID=YOUR_FACEBOOK_APP_ID

# Paystack Payment (Use LIVE key for production)
EXPO_PUBLIC_PAYSTACK_PUBLIC_KEY=pk_live_YOUR_LIVE_PUBLIC_KEY
