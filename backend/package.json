{
  "name": "marketplace-backend",
  "version": "1.0.0",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon",
    "test:e2e": "node scripts/e2e-smoke.js",
    "test:integration": "node scripts/run-integration-tests.js",
    "test:unit": "node --test test/seller-settlement.test.js",
    "load:test": "node scripts/load-test.js",
    "worker": "node worker.js",
    "build": "babel server.js worker.js config constants controllers jobs middleware models routes socket utils --out-dir dist --extensions \".js\" --copy-files && node scripts/write-dist-package.js",
    "serve": "npm run build && node dist/server.js"
  },
  "dependencies": {
    "@aws-sdk/client-rekognition": "^3.1095.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "axios": "^1.7.0",
    "bcryptjs": "^2.4.3",
    "bullmq": "^6.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "expo-server-sdk": "^3.11.0",
    "express": "^4.19.2",
    "express-rate-limit": "^7.1.5",
    "form-data": "^4.0.5",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.7.0",
    "mongoose": "^8.4.1",
    "node-fetch": "^2.7.0",
    "rate-limit-redis": "^4.2.1",
    "redis": "^6.2.1",
    "socket.io": "^4.8.3",
    "uuid": "^11.1.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.24.7",
    "@babel/core": "^7.24.7",
    "@babel/node": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "autocannon": "^8.0.0",
    "nodemon": "^3.1.10",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.2.2"
  },
