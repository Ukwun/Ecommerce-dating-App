{
  "expo": {
    "name": "BizMingle",
    "slug": "marketplace",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "marketplace",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "jsEngine": "hermes",
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:marketplace-app.com",
        "applinks:www.marketplace-app.com"
      ],
      "bundleIdentifier": "com.marketplace.app",
      "buildNumber": "1",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "com.marketplace.app",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "marketplace-app.com",
              "pathPrefix": "/dating-profile"
            },
            {
              "scheme": "https",
              "host": "www.marketplace-app.com",
              "pathPrefix": "/dating-profile"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.INTERNET",
        "android.permission.CAMERA"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/chat_sound.wav"
          ],
          "icon": "./assets/images/notification-icon.png",
          "color": "#FF8C00"
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermissions": "Allow Marketplace to access your location for local features."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Marketplace to access your photos.",
          "cameraPermission": "Allow Marketplace to access your camera."
        }
      ],
      "expo-font"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "543f74ae-39ce-4609-a1a1-8ef032c3c7a7"
      },
      "privacyPolicyUrl": "https://marketplace-app.com/privacy",
      "termsOfServiceUrl": "https://marketplace-app.com/terms"
    },
    "owner": "ukwun1",
    "runtimeVersion": {
      "policy": "appVersion"
    }
  }
}
